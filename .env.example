# Copy to .env on the PC and fill in. .env is never committed.
# Path to the Gemini key file (the key itself stays in that file).
MARKFLOW_GEMINI_KEY_FILE=%USERPROFILE%\Videos\MarkFlow\gemini_api.txt
# Google service account JSON (outside the repo).
MARKFLOW_GOOGLE_CREDENTIALS=
# Local cache for audio, transcripts and downloaded lives.
MARKFLOW_CACHE_DIR=%USERPROFILE%\Videos\MarkFlow\cache
